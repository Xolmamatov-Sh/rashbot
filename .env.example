# LOCALHOST sinovi uchun true qoldiring. Bu rejim Telegram botni ishga tushirmaydi.
# Faqat lokal brauzer sinovi uchun; internetga ochiq serverda true qoldirmang.
LOCAL_DEV=true
LOCAL_DEV_USER_ID=123456789
LOCAL_DEV_ADMIN=true

# Lokal sinovda BOT_TOKEN kerak emas. Telegram rejimiga o'tganda @BotFather tokenini kiriting.
BOT_TOKEN=

# Lokal brauzer sinovi uchun HTTPS domen talab qilinmaydi.
WEBAPP_URL=http://127.0.0.1:8080
ADMIN_IDS=123456789
DATABASE_PATH=./rash_bot.sqlite3
WEB_SERVER_HOST=127.0.0.1
WEB_SERVER_PORT=8080
INIT_DATA_MAX_AGE_SECONDS=86400
